# Environments and build products
.pixi/*
!.pixi/config.toml
__pycache__/
*.pyc
*.egg-info/
build/
.ipynb_checkpoints/

# Cluster-specific configuration: copy slurm/cluster.conf.template instead
slurm/cluster.conf

# Editor and assistant state
.vscode/
.claude/

# Data, logs and results never belong in the repository
/data/*
!/data/tutorial/
/data/tutorial/*
!/data/tutorial/pmssm-al-tutorial-data-v1.tar.gz
!/data/tutorial/pmssm-al-tutorial-data-v1.tar.gz.sha256
/logs/
/plots/
/analysis/
/review/
active_learning_*output*/
*_output_*/
pipeline_analysis*/

# Core dumps (a killed smoke test once left a 5.4 GB one in the repo root)
core.*

# The tutorial writes here (scripts/tutorial/run_tutorial.sh)
/tutorial_runs/
